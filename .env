# Flask Configuration
FLASK_ENV=development
SECRET_KEY=dev-secret-key-for-local-testing-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-testing
PORT=5000

# Database (SQLite for local development)
DATABASE_URL=sqlite:///guardian.db

# Admin Account
ADMIN_EMAIL=admin@guardian.local
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=*

# Guardian Settings
GUARDIAN_MAX_EVENTS=10000
GUARDIAN_CLEANUP_DAYS=30
GUARDIAN_ENABLE_NOTIFICATIONS=true
