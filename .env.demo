# Demo Environment Configuration
# This file is used for local demo/development

APP_NAME=Smart Login Guardian
APP_VERSION=2.0.0
ENVIRONMENT=demo
SECRET_KEY=demo-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true
LOG_LEVEL=info

# CORS (permissive for demo)
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# Demo Mode
DEMO_MODE=true
