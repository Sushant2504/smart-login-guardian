# Smart Login Guardian - Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME=Smart Login Guardian
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4
RELOAD=true

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Database - PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_login_guardian
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Database - ClickHouse (Analytics)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=analytics

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# Kafka/Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=authentication-events
KAFKA_TOPIC_ALERTS=security-alerts
KAFKA_CONSUMER_GROUP=smart-login-guardian

# Machine Learning
ML_MODEL_PATH=./models
ML_TRAIN_THRESHOLD=30
ML_CONTAMINATION=0.1
ML_AUTO_RETRAIN=true
ML_RETRAIN_INTERVAL=3600

# Risk Scoring
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MODERATE=40
RISK_THRESHOLD_ELEVATED=60
RISK_THRESHOLD_HIGH=80

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_PREFIX=slg

# External Services
IPINFO_TOKEN=
MAXMIND_LICENSE_KEY=
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Features
ENABLE_WEBSOCKET=true
ENABLE_ML_DETECTION=true
ENABLE_GEO_TRACKING=true
ENABLE_DEVICE_FINGERPRINTING=true

# Retention
EVENT_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555
